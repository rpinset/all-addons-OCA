<odoo>
    <record model="ir.ui.view" id="vcp_odoo_bin_package_form_view">
        <field name="model">vcp.odoo.bin.package</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="module_version_ids" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_bin_package_search_view">
        <field name="model">vcp.odoo.bin.package</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_bin_package_tree_view">
        <field name="model">vcp.odoo.bin.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_odoo_bin_package_act_window">
        <field name="name">Bin Packages</field>
        <field name="path">vcp-odoo-bin-package</field>
        <field name="res_model">vcp.odoo.bin.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
