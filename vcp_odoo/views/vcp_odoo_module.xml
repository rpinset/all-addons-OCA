<odoo>
    <record model="ir.ui.view" id="vcp_odoo_module_form_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_module_search_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="filter_with_version"
                    string="With version"
                    domain="[('version_count','>', 0)]"
                />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_module_tree_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field
                    name="repository_branch_ids"
                    widget="many2many_tags"
                    context="{'display_only_branch_name': 1}"
                />
                <field name="version_count" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_odoo_module_act_window">
        <field name="name">Modules</field>
        <field name="path">vcp-odoo-module</field>
        <field name="res_model">vcp.odoo.module</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_with_version': 1}</field>
    </record>
</odoo>
