<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="vcp_odoo_author_view_tree" model="ir.ui.view">
        <field name="model">vcp.odoo.author</field>
        <field name="arch" type="xml">
            <list string="Author" editable="bottom">
                <field name="name" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record id="vcp_odoo_author_view_search" model="ir.ui.view">
        <field name="model">vcp.odoo.author</field>
        <field name="arch" type="xml">
            <search string="Author">
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_odoo_author_act_window">
        <field name="name">Author</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vcp.odoo.author</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="vcp_odoo_author_view_search" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
