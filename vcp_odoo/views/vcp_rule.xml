<odoo>
    <record model="ir.ui.view" id="vcp_rule_form_view">
        <field name="model">vcp.rule</field>
        <field name="inherit_id" ref="vcp_management.vcp_rule_form_view" />
        <field name="arch" type="xml">
            <field name="branch_pattern" position="after">
                <field
                    name="odoo_module_rule_ids"
                    widget="many2many_tags"
                    invisible="rule_type != 'odoo_module'"
                />
            </field>
        </field>
    </record>
</odoo>
