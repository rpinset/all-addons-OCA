<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="job_import_orders" model="queue.job.function">
        <field
            name="model_id"
            ref="connector_mercadolibre.model_mercadolibre_backend"
        />
        <field name="method">_job_import_orders</field>
        <field
            name="channel_id"
            ref="connector_mercadolibre.channel_mercadolibre_import"
        />
        <field name="retry_pattern" eval="{1: 10, 2: 60, 3: 300}" />
    </record>
