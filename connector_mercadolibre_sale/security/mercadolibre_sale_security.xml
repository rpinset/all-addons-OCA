<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mercadolibre_partner_company_rule" model="ir.rule">
        <field name="name">Mercado Libre buyer multi-company</field>
        <field name="model_id" ref="model_mercadolibre_res_partner" />
        <field
            name="domain_force"
        >['|', ('backend_id.company_id', '=', False), ('backend_id.company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('connector_mercadolibre.group_mercadolibre_user'))]"
        />
    </record>
    <record id="mercadolibre_sale_company_rule" model="ir.rule">
