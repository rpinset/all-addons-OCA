<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_mercadolibre" model="ir.ui.view">
        <field name="name">sale.order.form.mercadolibre</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_mercadolibre_pack"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="not mercadolibre_pack_id"
                    groups="connector_mercadolibre.group_mercadolibre_user"
                >
                    <field
                        name="mercadolibre_pack_count"
                        widget="statinfo"
                        string="Pack"
                    />
                </button>
            </div>
            <notebook position="inside">
                <page
                    string="Mercado Libre"
                    name="mercadolibre"
                    groups="connector_mercadolibre.group_mercadolibre_user"
                >
                    <group>
                        <group>
                            <field name="mercadolibre_order_id" readonly="1" />
                            <field name="mercadolibre_pack_id" readonly="1" />
                            <field name="mercadolibre_payment_status" readonly="1" />
                            <field name="mercadolibre_sale_fee" readonly="1" />
                        </group>
                        <group>
                            <field name="mercadolibre_shipment_status" readonly="1" />
                            <field name="mercadolibre_logistic_type" readonly="1" />
                            <button
                                name="action_open_mercadolibre_binding"
                                type="object"
                                string="Open binding"
                                invisible="not mercadolibre_order_id"
                                class="btn-link"
                            />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="sale_order_view_search_mercadolibre" model="ir.ui.view">
        <field name="name">sale.order.search.mercadolibre</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter
                    name="mercadolibre"
                    string="Mercado Libre"
                    domain="[('mercadolibre_order_id', '!=', False)]"
                />
            </filter>
            <filter name="order_month" position="after">
                <filter
                    name="group_mercadolibre_pack"
                    string="Mercado Libre pack"
                    context="{'group_by': 'mercadolibre_pack_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
