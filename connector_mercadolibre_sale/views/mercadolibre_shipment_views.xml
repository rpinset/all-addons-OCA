<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mercadolibre_shipment_view_list" model="ir.ui.view">
        <field name="name">mercadolibre.shipment.list</field>
        <field name="model">mercadolibre.shipment</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'">
                <field name="external_id" />
                <field name="status" />
                <field name="logistic_type" />
                <field name="mode" />
                <field name="tracking_number" />
                <field name="picking_id" />
                <field name="backend_id" />
            </list>
        </field>
    </record>

    <record id="mercadolibre_shipment_view_form" model="ir.ui.view">
        <field name="name">mercadolibre.shipment.form</field>
        <field name="model">mercadolibre.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="button_import"
                        type="object"
                        string="Import"
                        groups="connector_mercadolibre.group_mercadolibre_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="external_id" />
                            <field name="status" />
                            <field name="logistic_type" />
                            <field name="mode" />
                        </group>
                        <group>
                            <field name="tracking_number" />
                            <field name="picking_id" />
                            <field name="receiver_partner_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders" name="orders">
                            <field name="sale_binding_ids" />
                        </page>
                        <page string="Error" name="error">
                            <field name="error_message" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mercadolibre_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">mercadolibre.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
