<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_view_form_mercadolibre" model="ir.ui.view">
        <field name="name">stock.picking.form.mercadolibre</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field
                    name="mercadolibre_shipment_id"
                    readonly="1"
                    groups="connector_mercadolibre.group_mercadolibre_user"
                />
                <field
                    name="mercadolibre_logistic_type"
                    readonly="1"
                    groups="connector_mercadolibre.group_mercadolibre_user"
                />
                <field
                    name="mercadolibre_tracking_number"
                    readonly="1"
                    groups="connector_mercadolibre.group_mercadolibre_user"
                />
            </field>
        </field>
    </record>
</odoo>
