<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_edi_connector_tree" model="ir.ui.view">
        <field name="name">l10n_py.edi.connector.tree</field>
        <field name="model">l10n_py.edi.connector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="provider_type" />
                <field name="environment" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_edi_connector_form" model="ir.ui.view">
        <field name="name">l10n_py.edi.connector.form</field>
        <field name="model">l10n_py.edi.connector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="test_connection"
                        string="Probar Conexión"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del conector" />
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="provider_type" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="environment" />
                            <field name="timeout" />
                            <field name="active" />
                        </group>
                        <group name="credentials" string="Credenciales">
                            <!-- Extended by provider modules via xpath -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_edi_connector" model="ir.actions.act_window">
        <field name="name">Conectores EDI</field>
        <field name="res_model">l10n_py.edi.connector</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu item under existing EDI menu -->
    <menuitem
        id="menu_edi_connector"
        name="Conectores"
        parent="menu_edi_connectors"
        action="action_edi_connector"
        sequence="10"
    />
</odoo>
