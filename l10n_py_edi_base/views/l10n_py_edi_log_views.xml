<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_py_edi_log_tree" model="ir.ui.view">
        <field name="name">l10n_py.edi.log.tree</field>
        <field name="model">l10n_py.edi.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="error==True" decoration-info="error==False">
                <field name="create_date" />
                <field name="operation_type" />
                <field name="document_id" />
                <field name="provider" />
                <field name="method" />
                <field name="endpoint" />
                <field name="status_code" />
                <field name="duration_human" />
                <field name="error" />
            </list>
        </field>
    </record>

    <record id="view_l10n_py_edi_log_form" model="ir.ui.view">
        <field name="name">l10n_py.edi.log.form</field>
        <field name="model">l10n_py.edi.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" />
                            <field name="operation_type" />
                            <field name="document_id" />
                            <field name="cdc" />
                            <field name="provider" />
                        </group>
                        <group>
                            <field name="method" />
                            <field name="endpoint" />
                            <field name="status_code" />
                            <field name="duration_human" />
                            <field name="success" />
                            <field name="error" />
                        </group>
                    </group>
                    <group string="Datos de Solicitud">
                        <field name="request_data" widget="text" />
                    </group>
                    <group string="Respuesta">
                        <field name="response_data" widget="text" />
                        <field name="error_message" widget="text" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_py_edi_log" model="ir.actions.act_window">
        <field name="name">Logs EDI</field>
        <field name="res_model">l10n_py.edi.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
