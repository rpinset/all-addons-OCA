<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Timbrado para Autofacturas                                   -->
    <!-- ============================================================ -->

    <record id="demo_authorization_afe" model="account.authorization">
        <field name="name">66778899</field>
        <field
            name="date_from"
            eval="(datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d')"
        />
        <field
            name="date_to"
            eval="(datetime.now() + timedelta(days=355)).strftime('%Y-%m-%d')"
        />
        <field name="invoice_number_from">1</field>
        <field name="invoice_number_to">1000</field>
        <field name="establishment">001</field>
        <field name="expedition_point">001</field>
        <field name="l10n_latam_document_type_id" ref="l10n_py_account.dc_py_af" />
        <field name="active" eval="True" />
    </record>

    <!-- ============================================================ -->
    <!-- Autofacturas Electrónicas (AFE — código 4)                   -->
    <!-- Requieren exactamente 1 constancia electrónica               -->
    <!-- ============================================================ -->

    <!-- AFE 1: Autofactura con constancia de no contribuyente -->
    <record id="demo_afe_no_contribuyente" model="account.move">
        <field name="partner_id" ref="l10n_py_account.partner_no_contribuyente_ci" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-23'" />
        <field name="l10n_latam_document_type_id" ref="l10n_py_account.dc_py_af" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_afe" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('l10n_py_account.product_iva_5_alimento'),
                'quantity': 500,
                'price_unit': 52500.0,
                'name': 'Compra directa de Yerba Mate a pequeño productor',
            }),
        ]"
        />
    </record>

    <!-- Constancia electrónica para AFE 1 -->
    <record
        id="demo_afe_no_contribuyente_constancia"
        model="l10n_py.associated.document"
    >
        <field name="move_id" ref="demo_afe_no_contribuyente" />
        <field name="association_type">3</field>
        <field name="constancia_type">1</field>
        <field name="constancia_number">CONST-NC-2026-001</field>
    </record>

    <!-- AFE 2: Autofactura con constancia de microproductor -->
    <record id="demo_afe_microproductor" model="account.move">
        <field name="partner_id" ref="l10n_py_account.partner_no_contribuyente_ci" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-24'" />
        <field name="l10n_latam_document_type_id" ref="l10n_py_account.dc_py_af" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_afe" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('l10n_py_account.product_iva_5_alimento'),
                'quantity': 1000,
                'price_unit': 52500.0,
                'name': 'Compra directa de Yerba a microproductor',
            }),
        ]"
        />
    </record>

    <!-- Constancia electrónica para AFE 2 -->
    <record id="demo_afe_microproductor_constancia" model="l10n_py.associated.document">
        <field name="move_id" ref="demo_afe_microproductor" />
        <field name="association_type">3</field>
        <field name="constancia_type">2</field>
        <field name="constancia_number">CONST-MP-2026-001</field>
    </record>

</odoo>
