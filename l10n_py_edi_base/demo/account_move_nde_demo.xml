<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Notas de Débito Electrónicas (NDE — código 6)                -->
    <!-- Requieren exactamente 1 documento asociado                   -->
    <!-- ============================================================ -->

    <!-- NDE 1: Nota de débito con documento electrónico asociado -->
    <record id="demo_nde_electronic" model="account.move">
        <field name="partner_id" ref="l10n_py_account.partner_contribuyente_general" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-18'" />
        <field name="l10n_latam_document_type_id" ref="l10n_py_account.dc_py_nd" />
        <field
            name="l10n_py_authorization_id"
            ref="l10n_py_account.demo_authorization_debit_note"
        />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('l10n_py_account.product_iva_10_servicio'),
                'quantity': 1,
                'price_unit': 550000.0,
                'name': 'Ajuste de precio - Servicio de Consultoría',
            }),
        ]"
        />
    </record>

    <!-- Documento asociado electrónico para NDE 1 -->
    <record id="demo_nde_electronic_assoc_doc" model="l10n_py.associated.document">
        <field name="move_id" ref="demo_nde_electronic" />
        <field name="association_type">1</field>
        <field name="cdc">01800123456001001000000032025010312345678903</field>
    </record>

    <!-- NDE 2: Nota de débito con documento impreso asociado -->
    <record id="demo_nde_printed" model="account.move">
        <field
            name="partner_id"
            ref="l10n_py_account.partner_contribuyente_servicios"
        />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-19'" />
        <field name="l10n_latam_document_type_id" ref="l10n_py_account.dc_py_nd" />
        <field
            name="l10n_py_authorization_id"
            ref="l10n_py_account.demo_authorization_debit_note"
        />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('l10n_py_account.product_iva_10_electronica'),
                'quantity': 1,
                'price_unit': 220000.0,
                'name': 'Flete adicional - Notebook Dell',
            }),
        ]"
        />
    </record>

    <!-- Documento asociado impreso para NDE 2 -->
    <record id="demo_nde_printed_assoc_doc" model="l10n_py.associated.document">
        <field name="move_id" ref="demo_nde_printed" />
        <field name="association_type">2</field>
        <field name="timbrado">12345678</field>
        <field name="establishment">001</field>
        <field name="expedition_point">001</field>
        <field name="doc_number">0000002</field>
        <field name="doc_type_code">1</field>
        <field name="doc_date" eval="time.strftime('%Y-%m') + '-03'" />
    </record>

</odoo>
