<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_move_send_edi_wizard" model="ir.ui.view">
        <field name="name">account.move.send.edi.wizard.form</field>
        <field name="model">account.move.send.edi.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="invoice_id" readonly="1" />
                    </group>
                    <footer>
                        <button
                            string="Enviar"
                            name="action_send"
                            type="object"
                            class="oe_highlight"
                        />
                        <button
                            string="Cancelar"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
