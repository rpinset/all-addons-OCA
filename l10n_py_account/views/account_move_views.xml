<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extensión de la vista de formulario de facturas -->
    <record id="view_move_form_py" model="ir.ui.view">
        <field name="name">account.move.form.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- Agregar timbrado debajo del document type (añadido por l10n_latam_invoice_document) -->
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">
                <field
                    name="l10n_py_authorization_id"
                    attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                />
                <field
                    name="l10n_py_full_invoice_number"
                    attrs="{'invisible': ['|', ('move_type', 'not in', ['out_invoice', 'out_refund']), ('l10n_py_authorization_id', '=', False)]}"
                    readonly="1"
                />
            </xpath>

            <!-- Agregar notebook con información fiscal paraguaya -->
            <xpath expr="//notebook" position="inside">
                <page
                    string="Información Fiscal Paraguay"
                    name="l10n_py_fiscal"
                    attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"
                >
                    <group>
                        <group string="Discriminación de IVA (SIFEN)">
                            <field
                                name="l10n_py_amount_exempt"
                                string="Exento (F003)"
                            />
                            <separator />
                            <field
                                name="l10n_py_amount_subtotal_5"
                                string="Total Gravado 5% (F004)"
                            />
                            <field
                                name="l10n_py_base_5"
                                string="Base Gravada 5% (F018)"
                            />
                            <field
                                name="l10n_py_amount_iva_5"
                                string="Liq. IVA 5% (F015)"
                            />
                            <separator />
                            <field
                                name="l10n_py_amount_subtotal_10"
                                string="Total Gravado 10% (F005)"
                            />
                            <field
                                name="l10n_py_base_10"
                                string="Base Gravada 10% (F019)"
                            />
                            <field
                                name="l10n_py_amount_iva_10"
                                string="Liq. IVA 10% (F016)"
                            />
                            <separator />
                            <field
                                name="l10n_py_amount_iva_total"
                                string="Total IVA (F014)"
                                style="font-weight: bold;"
                            />
                            <field
                                name="l10n_py_base_total"
                                string="Total Base Gravada (F020)"
                            />
                            <field
                                name="l10n_py_total_operation"
                                string="Total Operación (F008)"
                                style="font-weight: bold;"
                            />
                        </group>
                        <group>
                            <group string="Tipo de Cambio">
                                <field name="l10n_py_exchange_rate" />
                                <field
                                    name="l10n_py_amount_total_pyg"
                                    string="Total en Gs. (F023)"
                                />
                            </group>
                            <group string="Total en Letras">
                                <field name="l10n_py_amount_total_words" readonly="1" />
                            </group>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Extensión de la vista de lista de facturas -->
    <record id="view_invoice_tree_py" model="ir.ui.view">
        <field name="name">account.move.tree.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">

            <!-- Agregar columna de número completo de factura -->
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="l10n_py_full_invoice_number"
                    optional="show"
                    string="Nro. Factura"
                />
            </xpath>

            <!-- Agregar columna de timbrado -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="l10n_py_authorization_id" optional="hide" />
            </xpath>

        </field>
    </record>

</odoo>
