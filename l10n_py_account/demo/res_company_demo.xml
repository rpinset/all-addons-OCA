<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Configurar empresa principal como paraguaya.
         No cambiamos currency_id porque el módulo account puede haber
         creado journal items con la moneda por defecto, y Odoo bloquea
         cambios de moneda cuando ya existen asientos. -->
    <record id="base.main_company" model="res.company">
        <field name="name">Empresa Demo Paraguay SRL</field>
        <field name="country_id" ref="base.py" />
        <field name="account_fiscal_country_id" ref="base.py" />
        <field name="street">Avda. Mariscal López 3456</field>
        <field name="city">Asunción</field>
        <field name="state_id" ref="l10n_py_base.state_py_asuncion" />
        <field name="zip">1209</field>
        <field name="phone">+595 21 555 0000</field>
        <field name="email">info@empresademo.com.py</field>
        <field name="website">https://www.empresademo.com.py</field>
    </record>

    <!-- Aplicar plano de contas PY à empresa demo (padrão l10n_br) -->
    <function model="account.chart.template" name="try_loading">
        <value eval="[ref('l10n_py.py_chart_template')]" />
        <value model="res.company" eval="obj().env.ref('base.main_company')" />
    </function>

</odoo>
