<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- ============================================================ -->
    <!-- Facturas de Venta (FE) con distintas alícuotas IVA           -->
    <!-- ============================================================ -->

    <!-- FE 1: Factura con IVA 10% — Electrónica + Servicio -->
    <record id="demo_invoice_fe_iva10" model="account.move">
        <field name="partner_id" ref="partner_contribuyente_general" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-01'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_001" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_iva_10_electronica'),
                'quantity': 2,
                'price_unit': 5500000.0,
                'name': 'Notebook Dell Inspiron',
            }),
            (0, 0, {
                'product_id': ref('product_iva_10_servicio'),
                'quantity': 5,
                'price_unit': 1100000.0,
                'name': 'Servicio de Consultoría',
            }),
        ]"
        />
    </record>

    <!-- FE 2: Factura con IVA 5% — Alimentos + Farmacia -->
    <record id="demo_invoice_fe_iva5" model="account.move">
        <field name="partner_id" ref="partner_contribuyente_servicios" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-03'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_001" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_iva_5_alimento'),
                'quantity': 100,
                'price_unit': 52500.0,
                'name': 'Yerba Mate Kurupí 1kg',
            }),
            (0, 0, {
                'product_id': ref('product_iva_5_farmacia'),
                'quantity': 20,
                'price_unit': 157500.0,
                'name': 'Medicamento Genérico',
            }),
        ]"
        />
    </record>

    <!-- FE 3: Factura mixta — IVA 10% + IVA 5% + Exento -->
    <record id="demo_invoice_fe_mixta" model="account.move">
        <field name="partner_id" ref="partner_contribuyente_general" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-05'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_001" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_iva_10_electronica'),
                'quantity': 1,
                'price_unit': 5500000.0,
                'name': 'Notebook Dell Inspiron',
            }),
            (0, 0, {
                'product_id': ref('product_iva_5_alimento'),
                'quantity': 50,
                'price_unit': 52500.0,
                'name': 'Yerba Mate Kurupí 1kg',
            }),
            (0, 0, {
                'product_id': ref('product_exento_libro'),
                'quantity': 10,
                'price_unit': 120000.0,
                'name': 'Libro Historia del Paraguay',
            }),
        ]"
        />
    </record>

    <!-- FE 4: Factura a no contribuyente con CI -->
    <record id="demo_invoice_fe_no_contribuyente" model="account.move">
        <field name="partner_id" ref="partner_no_contribuyente_ci" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-08'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_001" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_iva_10_electronica'),
                'quantity': 1,
                'price_unit': 5500000.0,
                'name': 'Notebook Dell Inspiron',
            }),
        ]"
        />
    </record>

    <!-- FE 5: Factura exenta -->
    <record id="demo_invoice_fe_exenta" model="account.move">
        <field name="partner_id" ref="partner_contribuyente_servicios" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-10'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_001" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_exento_libro'),
                'quantity': 25,
                'price_unit': 120000.0,
                'name': 'Libro Historia del Paraguay',
            }),
        ]"
        />
    </record>

    <!-- FE 6: Factura con punto de expedición alternativo -->
    <record id="demo_invoice_fe_punto2" model="account.move">
        <field name="partner_id" ref="partner_contribuyente_general" />
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m') + '-12'" />
        <field name="l10n_py_authorization_id" ref="demo_authorization_002" />
        <field
            name="invoice_line_ids"
            eval="[
            (0, 0, {
                'product_id': ref('product_iva_10_servicio'),
                'quantity': 10,
                'price_unit': 1100000.0,
                'name': 'Servicio de Consultoría',
            }),
        ]"
        />
    </record>

    <!-- ============================================================ -->
    <!-- Confirmar todas las facturas (asigna numeración automática)   -->
    <!-- ============================================================ -->
    <function model="account.move" name="action_post">
        <value
            eval="[
            ref('demo_invoice_fe_iva10'),
            ref('demo_invoice_fe_iva5'),
            ref('demo_invoice_fe_mixta'),
            ref('demo_invoice_fe_no_contribuyente'),
            ref('demo_invoice_fe_exenta'),
            ref('demo_invoice_fe_punto2'),
        ]"
        />
    </function>
</odoo>
