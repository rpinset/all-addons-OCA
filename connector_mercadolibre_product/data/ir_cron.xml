<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_reconcile_listings" model="ir.cron">
        <field name="name">Mercado Libre: reconcile listings</field>
        <field
            name="model_id"
            ref="connector_mercadolibre.model_mercadolibre_backend"
        />
        <field name="state">code</field>
        <field name="code">model.cron_import_listings()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
