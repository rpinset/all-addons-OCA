<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit mrp.bom form to add Maquila fields -->
    <record id="mrp_bom_form_view_inherit_maquila" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.maquila</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Maquila" name="maquila">
                    <group>
                        <field name="l10n_py_maquila_program_id" />
                        <field name="l10n_py_intn_certified" />
                    </group>
                    <group>
                        <field
                            name="l10n_py_intn_certificate"
                            invisible="not l10n_py_intn_certified"
                        />
                        <field
                            name="l10n_py_intn_date"
                            invisible="not l10n_py_intn_certified"
                        />
                    </group>
                </group>
            </xpath>
            <!-- Add origin columns to BOM line tree -->
            <xpath
                expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']"
                position="after"
            >
                <field name="l10n_py_origin_type" optional="hide" />
                <field name="l10n_py_origin_country" optional="hide" />
                <!--
                    Gross/net quantity helpers derived from GRAP's
                    mrp_bom_line_net_qty (Copyright (C) 2023 GRAP,
                    http://www.grap.coop, @author Quentin DUPONT).
                -->
                <field name="diff_product_qty_gross_net" column_invisible="1" />
                <button
                    name="set_product_qty_gross"
                    icon="fa-arrow-left"
                    type="object"
                    invisible="diff_product_qty_gross_net == 0"
                    title="Set the gross quantity from the net quantity and the loss percentage"
                />
                <field name="loss_percentage" />
                <button
                    name="set_product_qty_net"
                    icon="fa-arrow-right"
                    type="object"
                    invisible="diff_product_qty_gross_net == 0"
                    title="Set the net quantity from the gross quantity and the loss percentage"
                />
                <field name="product_qty_net" />
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list" position="attributes">
                <attribute
                    name="decoration-warning"
                >diff_product_qty_gross_net != 0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit maquila program product tree to add bom_id -->
    <record id="view_maquila_program_form_inherit_mrp" model="ir.ui.view">
        <field name="name">l10n_py.maquila.program.form.inherit.mrp</field>
        <field name="model">l10n_py.maquila.program</field>
        <field name="inherit_id" ref="l10n_py_maquila_base.view_maquila_program_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='product_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field name="bom_id" />
            </xpath>
        </field>
    </record>
</odoo>
