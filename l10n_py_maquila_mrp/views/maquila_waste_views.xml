<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_maquila_waste_form" model="ir.ui.view">
        <field name="name">l10n_py.maquila.waste.form</field>
        <field name="model">l10n_py.maquila.waste</field>
        <field name="arch" type="xml">
            <form string="Maquila Waste">
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending'"
                    />
                    <button
                        name="action_complete"
                        string="Complete"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'in_process'"
                    />
                    <button
                        name="action_pending"
                        string="Reset to Pending"
                        type="object"
                        invisible="state == 'pending'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,in_process,completed"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Waste Details">
                            <field name="date" />
                            <field name="program_id" />
                            <field name="production_id" />
                            <field name="product_id" />
                            <field name="lot_id" />
                            <field name="quantity" />
                        </group>
                        <group string="Classification">
                            <field name="waste_type" />
                            <field name="destination" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group string="Regulatory">
                        <group>
                            <field name="destruction_certificate" />
                            <field name="seam_approval" />
                        </group>
                        <group>
                            <field name="scrap_id" />
                            <field name="nationalization_move_id" />
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="justification" nolabel="1" colspan="2" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_maquila_waste_tree" model="ir.ui.view">
        <field name="name">l10n_py.maquila.waste.tree</field>
        <field name="model">l10n_py.maquila.waste</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state == 'completed'"
                decoration-warning="state == 'in_process'"
            >
                <field name="date" />
                <field name="program_id" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="waste_type" />
                <field name="destination" />
                <field
                    name="state"
                    decoration-success="state == 'completed'"
                    decoration-info="state == 'pending'"
                    decoration-warning="state == 'in_process'"
                    widget="badge"
                />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_maquila_waste_search" model="ir.ui.view">
        <field name="name">l10n_py.maquila.waste.search</field>
        <field name="model">l10n_py.maquila.waste</field>
        <field name="arch" type="xml">
            <search string="Maquila Waste">
                <field name="program_id" />
                <field name="product_id" />
                <separator />
                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="filter_in_process"
                    string="In Process"
                    domain="[('state', '=', 'in_process')]"
                />
                <filter
                    name="filter_completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"
                />
                <separator />
                <filter
                    name="filter_scrap"
                    string="Scrap"
                    domain="[('waste_type', '=', 'scrap')]"
                />
                <filter
                    name="filter_byproduct"
                    string="Byproduct"
                    domain="[('waste_type', '=', 'byproduct')]"
                />
                <filter
                    name="filter_defective"
                    string="Defective"
                    domain="[('waste_type', '=', 'defective')]"
                />
                <separator />
                <filter
                    name="filter_destruction"
                    string="Destruction"
                    domain="[('destination', '=', 'destruction')]"
                />
                <filter
                    name="filter_nationalization"
                    string="Nationalization"
                    domain="[('destination', '=', 'nationalization')]"
                />
                <filter
                    name="filter_reexport"
                    string="Re-export"
                    domain="[('destination', '=', 'reexport')]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_program"
                        string="Program"
                        context="{'group_by': 'program_id'}"
                    />
                    <filter
                        name="group_waste_type"
                        string="Waste Type"
                        context="{'group_by': 'waste_type'}"
                    />
                    <filter
                        name="group_destination"
                        string="Destination"
                        context="{'group_by': 'destination'}"
                    />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maquila_waste" model="ir.actions.act_window">
        <field name="name">Waste Management</field>
        <field name="res_model">l10n_py.maquila.waste</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_maquila_waste_search" />
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new waste record
            </p>
            <p>
                Track scrap, byproducts, and defective materials from
                maquila production processes.
            </p>
        </field>
    </record>
</odoo>
