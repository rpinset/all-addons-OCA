<odoo>
    <record model="ir.actions.act_window" id="vcp_request_2_review_act_window">
        <field name="name">Reviews</field>
        <field name="res_model">vcp.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("request_id", "=", active_id)]</field>
    </record>

    <record model="ir.actions.act_window" id="vcp_request_2_comment_act_window">
        <field name="name">Comments</field>
        <field name="res_model">vcp.comment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("request_id", "=", active_id)]</field>
    </record>

    <record model="ir.ui.view" id="vcp_request_form_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            class="oe_stat_button"
                            icon="fa-eye"
                            type="action"
                            name="%(vcp_request_2_review_act_window)d"
                        >
                            <field
                                name="review_count"
                                string="Reviews"
                                widget="statinfo"
                            />
                        </button>
                        <button
                            class="oe_stat_button"
                            icon="fa-comments"
                            type="action"
                            name="%(vcp_request_2_comment_act_window)d"
                        >
                            <field
                                name="comment_count"
                                string="Comments"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Draft"
                        bg_color="bg-info"
                        invisible="status != 'draft'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Open"
                        bg_color="bg-primary"
                        invisible="status != 'open'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Merged"
                        bg_color="bg-success"
                        invisible="status != 'merged'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Closed"
                        bg_color="bg-danger"
                        invisible="status != 'closed'"
                    />
                    <field name="is_draft" invisible="1" />
                    <field name="is_merged" invisible="1" />
                    <field name="closed_at" invisible="1" />
                    <group>
                        <field name="external_id" />
                        <field
                            name="label_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color'}"
                        />
                        <field name="url" widget="url" />
                        <field name="organization_id" />
                        <field name="repository_id" />
                        <field name="branch_id" />
                        <field name="number" />
                        <field name="name" />
                        <field name="state" />
                        <field name="partner_id" />
                        <field name="created_at" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_request_search_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="organization_id" />
                <field name="repository_id" />
                <field name="branch_id" />
                <field name="number" />
                <field name="name" />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('status','in', ('draft', 'open'))]"
                />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_request_tree_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <list default_order="created_at asc">
                <field name="organization_id" />
                <field name="repository_id" />
                <field name="branch_id" />
                <field name="number" />
                <field name="name" />
                <field name="created_at" optional="show" />
                <field
                    name="label_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="url" widget="url" optional="hide" />
                <field name="comment_count" optional="hide" />
                <field name="review_count" optional="hide" />
                <field
                    name="status"
                    decoration-info="status == 'draft'"
                    decoration-primary="status == 'open'"
                    decoration-success="status == 'merged'"
                    decoration-danger="status == 'closed'"
                    widget="badge"
                />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_request_act_window">
        <field name="name">Requests</field>
        <field name="path">vcp-request</field>
        <field name="res_model">vcp.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
