<odoo>
    <record model="ir.ui.view" id="vcp_rule_form_view">
        <field name="model">vcp.rule</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <group>
                        <field name="name" />
                        <field name="rule_type" />
                        <field name="branch_pattern" />
                    </group>
                    <notebook>
                        <page string="Settings" name="settings">
                            <field name="paths" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_rule_search_view">
        <field name="model">vcp.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_rule_tree_view">
        <field name="model">vcp.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_rule_act_window">
        <field name="name">Processing Rules</field>
        <field name="path">vcp-rule</field>
        <field name="res_model">vcp.rule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
