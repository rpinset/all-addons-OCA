<odoo>
    <record model="ir.actions.act_window" id="vcp_repository_2_request_act_window">
        <field name="name">Requests</field>
        <field name="path">vcp-repository-to-request</field>
        <field name="res_model">vcp.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("repository_id", "=", active_id)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record model="ir.ui.view" id="vcp_repository_form_view">
        <field name="model">vcp.repository</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="update_information"
                        type="object"
                        string="Update Information"
                        class="oe_highlight"
                    />
                    <button
                        name="force_update_information"
                        type="object"
                        string="Force Update Information (1Y)"
                        class="oe_highlight"
                    />
                    <button
                        name="update_branches"
                        type="object"
                        string="Update Branches"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" icon="fa-star">
                            <field
                                name="stargazers_count"
                                string="Stars"
                                widget="statinfo"
                            />
                        </button>
                        <button class="oe_stat_button" icon="fa-code-fork">
                            <field name="fork_count" string="Forks" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" icon="fa-eye">
                            <field
                                name="watchers_count"
                                string="Watchers"
                                widget="statinfo"
                            />
                        </button>
                        <button
                            class="oe_stat_button"
                            icon="fa-code-fork fa-flip-vertical"
                            type="action"
                            name="%(vcp_repository_2_request_act_window)d"
                        >
                            <field
                                name="request_count"
                                string="Requests"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="fetch_branch_pattern" />
                        <field name="last_commit_date" />
                        <field name="is_fork" />
                        <field name="platform_id" />
                        <field
                            name="scheduled_information_update"
                            widget="boolean_toggle"
                        />
                        <field name="scheduled_branch_update" widget="boolean_toggle" />
                        <field name="rule_ids" widget="many2many_tags" />
                        <field name="override_parent_rules" />
                        <field name="from_date" />
                        <field name="branch_update_date" />
                    </group>
                    <notebook>
                        <page string="Branches" name="branches">
                            <field name="branch_ids">
                                <list>
                                    <field
                                        name="branch_id"
                                        domain="[('platform_id', '=', platform_id)]"
                                    />
                                    <field name="platform_id" column_invisible="1" />
                                    <field name="last_commit" />
                                    <button
                                        name="process_rules"
                                        type="object"
                                        string="Process Rules"
                                        class="oe_highlight"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_repository_search_view">
        <field name="model">vcp.repository</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
                <filter
                    name="filter_not_active"
                    string="Archived"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_repository_tree_view">
        <field name="model">vcp.repository</field>
        <field name="arch" type="xml">
            <list default_order="from_date asc" decoration-muted="not active">
                <field name="name" />
                <field name="description" />
                <field name="platform_id" />
                <field name="last_commit_date" optional="show" />
                <field name="from_date" />
                <field name="branch_count" optional="show" />
                <field name="fork_count" />
                <field
                    name="scheduled_information_update"
                    widget="boolean_toggle"
                    optional="hide"
                />
                <field
                    name="scheduled_branch_update"
                    widget="boolean_toggle"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_repository_act_window">
        <field name="name">Repositories</field>
        <field name="path">vcp-repository</field>
        <field name="res_model">vcp.repository</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
