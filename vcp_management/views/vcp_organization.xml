<odoo>
    <record model="ir.ui.view" id="vcp_organization_form_view">
        <field name="model">vcp.organization</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="external_id" />
                        <field name="host_id" />
                        <field name="partner_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_organization_search_view">
        <field name="model">vcp.organization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_organization_tree_view">
        <field name="model">vcp.organization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_organization_act_window">
        <field name="name">Organizations</field>
        <field name="path">vcp-organization</field>
        <field name="res_model">vcp.organization</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
