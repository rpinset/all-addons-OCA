<odoo>
    <record model="ir.ui.view" id="vcp_host_form_view">
        <field name="model">vcp.host</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field
                            name="type_id"
                            options="{'no_create': 1, 'no_open': 1}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_host_search_view">
        <field name="model">vcp.host</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_host_tree_view">
        <field name="model">vcp.host</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type_id" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_host_act_window">
        <field name="name">Platform Types</field>
        <field name="path">vcp-host</field>
        <field name="res_model">vcp.host</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
