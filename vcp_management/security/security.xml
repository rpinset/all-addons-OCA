<odoo>
    <record model="ir.module.category" id="module_category_vcp">
        <field name="name">VCP</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_vcp_user" model="res.groups">
        <field name="name">VCP User</field>
        <field name="category_id" ref="module_category_vcp" />
    </record>
    <record id="group_vcp_manager" model="res.groups">
        <field name="name">VCP Manager</field>
        <field name="category_id" ref="module_category_vcp" />
        <field
            name="users"
            eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"
        />
        <field name="implied_ids" eval="[(4, ref('vcp_management.group_vcp_user'))]" />
    </record>
</odoo>
