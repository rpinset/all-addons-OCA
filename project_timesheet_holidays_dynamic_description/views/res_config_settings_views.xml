<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.project.timesheet.holidays</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='timesheet_off_validation_setting']"
                position="after"
            >
                <setting title="Timesheet descriptions will include the leave reason.">
                    <field name="dynamic_timesheet_description" />
                    <div class="text-muted">
                        Append the leave description to the generated timesheet name
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
