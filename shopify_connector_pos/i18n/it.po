#. module: shopify_connector_pos
#. odoo-python
#: code:addons/shopify_connector_pos/models/pos.py:0
msgid "The POS cash-rounding product must be a service product."
msgstr ""
"Il prodotto POS per l'arrotondamento dei contanti deve essere un servizio."

#. module: shopify_connector_pos
#. odoo-python
#: code:addons/shopify_connector_pos/models/pos.py:0
