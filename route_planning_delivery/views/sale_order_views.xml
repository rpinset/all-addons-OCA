<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="route_planning_sale_stock.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_area_id']" position="attributes">
                <attribute
                    name="invisible"
                >delivery_type != 'route_planning'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
