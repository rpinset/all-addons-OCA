<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="route_planning_stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_area_id']" position="attributes">
                <attribute
                    name="invisible"
                >not partner_id or delivery_type != 'route_planning'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
