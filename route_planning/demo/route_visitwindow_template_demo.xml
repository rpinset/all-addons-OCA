<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="visit_window_template_demo" model="route.visitwindow.template">
        <field name="name">Monday-Friday from 10:00 to 12:00</field>
        <field
            name="line_ids"
            eval="[
            Command.create({'day_of_week': '0', 'time_from': 10, 'time_to': 12}),
            Command.create({'day_of_week': '1', 'time_from': 10, 'time_to': 12}),
            Command.create({'day_of_week': '2', 'time_from': 10, 'time_to': 12}),
            Command.create({'day_of_week': '3', 'time_from': 10, 'time_to': 12}),
            Command.create({'day_of_week': '4', 'time_from': 10, 'time_to': 12}),
        ]"
        />
    </record>
</odoo>
