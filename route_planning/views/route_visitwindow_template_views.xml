<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_route_visitwindow_template_list" model="ir.ui.view">
        <field name="name">route.visitwindow.template.list</field>
        <field name="model">route.visitwindow.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_route_visitwindow_template_form" model="ir.ui.view">
        <field name="name">route.visitwindow.template.form</field>
        <field name="model">route.visitwindow.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <notebook>
                        <page string="Visit Windows">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="day_of_week" />
                                    <field name="time_from" widget="float_time" />
                                    <field name="time_to" widget="float_time" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_route_visitwindow_template_search" model="ir.ui.view">
        <field name="name">route.visitwindow.template.search</field>
        <field name="model">route.visitwindow.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="filter_inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_route_visitwindow_template" model="ir.actions.act_window">
        <field name="name">Visit Window Templates</field>
        <field name="res_model">route.visitwindow.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first visit window template
            </p>
            <p>
                Templates help standardize visit windows for partners.
            </p>
        </field>
    </record>
</odoo>
