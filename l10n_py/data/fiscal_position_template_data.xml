    <!-- Fiscal Position: Compras - destinadas a generar operaciones no gravadas o exentas -->
    <record
        id="py_fiscal_position_compras_no_gravadas_exentas"
        model="account.fiscal.position.template"
    >
        <field name="chart_template_id" ref="l10n_py.py_chart_template" />
        <field
            name="name"
        >Compras - destinadas a generar operaciones no gravadas o exentas</field>
        <field name="country_id" ref="base.py" />
        <field name="auto_apply" eval="False" />
    </record>

