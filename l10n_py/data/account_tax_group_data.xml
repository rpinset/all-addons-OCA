<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Grupos de Impuestos para Paraguay -->
    <record id="tax_group_iva_10" model="account.tax.group">
            <field name="name">IVA 10%</field>
            <field name="sequence">1</field>
            <field name="country_id" ref="base.py" />
        </record>

        <record id="tax_group_iva_5" model="account.tax.group">
            <field name="name">IVA 5%</field>
            <field name="sequence">2</field>
            <field name="country_id" ref="base.py" />
        </record>

        <record id="tax_group_exempt" model="account.tax.group">
            <field name="name">Exento</field>
            <field name="sequence">3</field>
            <field name="country_id" ref="base.py" />
        </record>

</odoo>
