#. module: stock_removal_zone_fifo
#: model:ir.model.fields,field_description:stock_removal_zone_fifo.field_res_company__zone_in_date_update_out_of_zone
#: model:ir.model.fields,field_description:stock_removal_zone_fifo.field_res_config_settings__zone_in_date_update_out_of_zone
#: model_terms:ir.ui.view,arch_db:stock_removal_zone_fifo.res_config_settings_view_form
msgid "Update Zone Entry Date out of Zones"
msgstr "Aggiorna la data di ingresso in zona da fuori zona"

#. module: stock_removal_zone_fifo
#: model_terms:ir.ui.view,arch_db:stock_removal_zone_fifo.res_config_settings_view_form
msgid ""
"Update the zone entry date when goods are moved to a location that is in no "
"zone."
msgstr ""
"Aggiornare la data di ingresso in zona quando le merci vengono spostate in "
"un'ubicazione che non si trova in alcuna zona."

#. module: stock_removal_zone_fifo
#: model:ir.model.fields,help:stock_removal_zone_fifo.field_res_company__zone_in_date_update_out_of_zone
#: model:ir.model.fields,help:stock_removal_zone_fifo.field_res_config_settings__zone_in_date_update_out_of_zone
msgid ""
"Update the zone entry date when goods are moved to a location that is in no "
"zone. Off by default, as no zone-based removal strategy sorts them there."
msgstr ""
"Aggiorna la data di ingresso in zona quando la merce viene spostata in una "
"ubicazione che non appartiene ad alcuna zona. Disattivato per impostazione "
"predefinita, poiché nessuna strategia di prelievo basata sulle zone prevede "
"lo spostamento in tali ubicazioni."

#. module: stock_removal_zone_fifo
#: model:ir.model.fields,field_description:stock_removal_zone_fifo.field_stock_quant__zone_in_date
msgid "Zone Entry Date"
msgstr "Data entrata nella zona"

