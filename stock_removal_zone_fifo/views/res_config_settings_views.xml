<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.zone.in.date</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="warehouse_setting_container" position="inside">
                <setting
                    string="Update Zone Entry Date out of Zones"
                    help="Update the zone entry date when goods are moved to a location that is in no zone."
                >
                    <field name="zone_in_date_update_out_of_zone" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
