<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mautic_backend_view_form" model="ir.ui.view">
        <field name="name">mautic.backend.form</field>
        <field name="model">mautic.backend</field>
        <field name="arch" type="xml">
            <form string="Mautic Backend">
                <header>
                    <button
                        name="action_authorize"
                        type="object"
                        string="Connect to Mautic"
                        class="oe_highlight"
                        invisible="state == 'connected'"
                    />
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        invisible="state != 'connected'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Production Mautic" />
                        </h1>
                    </div>
                    <group>
                        <group name="connection" string="Connection">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field
                                name="api_url"
                                placeholder="https://mautic.example.com"
                            />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="oauth" string="OAuth2 Credentials">
                            <field name="client_id" />
                            <field name="client_secret" password="True" />
                            <field name="redirect_url" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mautic_backend_view_list" model="ir.ui.view">
        <field name="name">mautic.backend.list</field>
        <field name="model">mautic.backend</field>
        <field name="arch" type="xml">
            <list string="Mautic Backends">
                <field name="name" />
                <field name="api_url" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="mautic_backend_view_search" model="ir.ui.view">
        <field name="name">mautic.backend.search</field>
        <field name="model">mautic.backend</field>
        <field name="arch" type="xml">
            <search string="Mautic Backends">
                <field name="name" />
                <field name="api_url" />
            </search>
        </field>
    </record>

    <record id="mautic_backend_action" model="ir.actions.act_window">
        <field name="name">Mautic Backends</field>
        <field name="res_model">mautic.backend</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
