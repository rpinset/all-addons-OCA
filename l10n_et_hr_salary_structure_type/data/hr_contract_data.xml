        <record id="et_contract" model="hr.payroll.structure.type">
            <field name="name">Contract Staff</field>
            <field name="country_id" ref="base.et" />
        </record>
        <record id="et_part" model="hr.payroll.structure.type">
            <field name="name">Part-time Staff</field>
            <field name="country_id" ref="base.et" />
        </record>
        <record id="et_casual" model="hr.payroll.structure.type">
            <field name="name">Casual Labour</field>
            <field name="country_id" ref="base.et" />
        </record>
        <record id="et_expath" model="hr.payroll.structure.type">
            <field name="name">Expatriate Staff</field>
            <field name="country_id" ref="base.et" />
        </record>
    </data>

</odoo>
