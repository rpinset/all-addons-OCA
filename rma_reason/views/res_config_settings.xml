<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rma.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="rma_operations_block" position="inside">
                <setting
                    help="Indicates whether specifying an RMA reason is mandatory when creating an RMA order.
                            Enabling this ensures that all return requests have a documented reason, aiding in inventory management, quality control, and customer service."
                    company_specific="1"
                >
                    <field name="is_rma_reason_required" string="RMA Reason" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
