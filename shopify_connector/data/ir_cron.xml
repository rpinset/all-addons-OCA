<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_prune_shopify_logs" model="ir.cron">
        <field name="name">Shopify: Prune old synchronization logs</field>
        <field name="model_id" ref="model_shopify_log" />
        <field name="state">code</field>
        <field name="code">model._cron_prune()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_prune_shopify_webhook_events" model="ir.cron">
        <field name="name">Shopify: Prune completed webhook events</field>
        <field name="model_id" ref="model_shopify_webhook_event" />
        <field name="state">code</field>
        <field name="code">model._cron_prune()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_reconcile_shopify_products" model="ir.cron">
        <field name="name">Shopify Drift: Products (daily)</field>
        <field name="model_id" ref="model_shopify_instance" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_products()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_reconcile_shopify_inventory" model="ir.cron">
        <field name="name">Shopify Drift: Inventory (daily)</field>
        <field name="model_id" ref="model_shopify_instance" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_inventory()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_reconcile_shopify_orders" model="ir.cron">
        <field name="name">Shopify Drift: Orders, 2-day overlap (daily)</field>
        <field name="model_id" ref="model_shopify_instance" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_reconcile_shopify_customers" model="ir.cron">
        <field name="name">Shopify Drift: Customers (weekly)</field>
        <field name="model_id" ref="model_shopify_instance" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_customers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True" />
    </record>
</odoo>
