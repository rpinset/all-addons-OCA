<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopify_log_view_list" model="ir.ui.view">
        <field name="name">shopify.log.list</field>
        <field name="model">shopify.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="instance_id" />
                <field name="entity" />
                <field name="direction" />
                <field
                    name="level"
                    widget="badge"
                    decoration-info="level == 'info'"
                    decoration-warning="level == 'warning'"
                    decoration-danger="level == 'error'"
                />
                <field name="message" />
                <field name="res_model" optional="hide" />
                <field name="res_id" optional="hide" />
                <button
                    name="action_open_related_record"
                    type="object"
                    string="Open"
                    icon="fa-external-link"
                    invisible="not res_model or not res_id"
                />
            </list>
        </field>
    </record>

    <record id="shopify_log_view_search" model="ir.ui.view">
        <field name="name">shopify.log.search</field>
        <field name="model">shopify.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message" />
                <field name="entity" />
                <field name="instance_id" />
                <filter
                    name="errors"
                    string="Errors"
                    domain="[('level', '=', 'error')]"
                />
                <filter
                    name="warnings"
                    string="Warnings"
                    domain="[('level', '=', 'warning')]"
                />
                <filter name="infos" string="Info" domain="[('level', '=', 'info')]" />
                <separator />
                <filter
                    name="imports"
                    string="Shopify to Odoo"
                    domain="[('direction', '=', 'import')]"
                />
                <filter
                    name="exports"
                    string="Odoo to Shopify"
                    domain="[('direction', '=', 'export')]"
                />
                <group>
                    <filter
                        name="group_instance"
                        string="Instance"
                        context="{'group_by': 'instance_id'}"
                    />
                    <filter
                        name="group_entity"
                        string="Entity"
                        context="{'group_by': 'entity'}"
                    />
                    <filter
                        name="group_level"
                        string="Level"
                        context="{'group_by': 'level'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'create_date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_log_action" model="ir.actions.act_window">
        <field name="name">Synchronization Logs</field>
        <field name="res_model">shopify.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="shopify_log_view_search" />
    </record>
</odoo>
