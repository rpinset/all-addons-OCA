<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopify_webhook_event_view_list" model="ir.ui.view">
        <field name="name">shopify.webhook.event.list</field>
        <field name="model">shopify.webhook.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_retry_dispatch"
                        type="object"
                        string="Retry Failed"
                        class="oe_highlight"
                    />
                </header>
                <field name="create_date" />
                <field name="instance_id" />
                <field name="topic" />
                <field name="webhook_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state in ('received', 'queued')"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'error'"
                />
            </list>
        </field>
    </record>

    <record id="shopify_webhook_event_view_form" model="ir.ui.view">
        <field name="name">shopify.webhook.event.form</field>
        <field name="model">shopify.webhook.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_retry_dispatch"
                        type="object"
                        string="Retry"
                        class="oe_highlight"
                        invisible="state != 'error'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id" />
                            <field name="topic" />
                            <field name="webhook_id" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="write_date" />
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" />
                    </group>
                    <group string="Raw Payload">
                        <field name="payload" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_webhook_event_view_search" model="ir.ui.view">
        <field name="name">shopify.webhook.event.search</field>
        <field name="model">shopify.webhook.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="webhook_id" />
                <field name="topic" />
                <field name="instance_id" />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', 'in', ('received', 'queued'))]"
                />
                <filter
                    name="errors"
                    string="Errors"
                    domain="[('state', '=', 'error')]"
                />
                <group>
                    <filter
                        name="group_instance"
                        string="Instance"
                        context="{'group_by': 'instance_id'}"
                    />
                    <filter
                        name="group_topic"
                        string="Topic"
                        context="{'group_by': 'topic'}"
                    />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'create_date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_webhook_event_action" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">shopify.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shopify_webhook_event_view_search" />
    </record>

    <record id="action_retry_shopify_webhooks" model="ir.actions.server">
        <field name="name">Requeue Failed Webhook Events</field>
        <field name="model_id" ref="model_shopify_webhook_event" />
        <field name="binding_model_id" ref="model_shopify_webhook_event" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_retry_dispatch()</field>
    </record>
</odoo>
