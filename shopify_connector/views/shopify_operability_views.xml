    <record id="shopify_product_search_operability" model="ir.ui.view">
        <field name="name">shopify.product.search.operability</field>
        <field name="model">shopify.product.template</field>
        <field name="inherit_id" ref="shopify_product_template_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='pending']" position="after">
                <filter
                    name="synced"
                    string="Synced"
                    domain="[('state', '=', 'synced')]"
                />
            </xpath>
        </field>
    </record>
    <record id="shopify_collection_search_operability" model="ir.ui.view">
        <field name="name">shopify.collection.search.operability</field>
        <field name="model">shopify.collection</field>
        <field name="inherit_id" ref="shopify_collection_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='errors']" position="after">
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="synced"
                    string="Synced"
                    domain="[('state', '=', 'synced')]"
                />
            </xpath>
        </field>
    </record>
    <record id="shopify_location_search_operability" model="ir.ui.view">
        <field name="name">shopify.location.search.operability</field>
        <field name="model">shopify.location</field>
        <field name="inherit_id" ref="shopify_location_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator />
                <filter
                    name="errors"
                    string="Errors"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="synced"
                    string="Synced"
                    domain="[('state', '=', 'synced')]"
                />
            </xpath>
        </field>
    </record>

