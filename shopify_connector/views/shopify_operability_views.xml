<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopify_binding_state_search_base" model="ir.ui.view">
        <field name="name">shopify.binding.state.search.base</field>
        <field name="model">shopify.product.variant</field>
        <field name="arch" type="xml">
            <search>
                <field name="shopify_id" />
                <field name="instance_id" />
                <filter
                    name="state_error"
                    string="Errors"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    name="state_pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="state_synced"
                    string="Synced"
                    domain="[('state', '=', 'synced')]"
                />
                <group>
                    <filter
                        name="group_instance"
                        string="Instance"
                        context="{'group_by': 'instance_id'}"
                    />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

