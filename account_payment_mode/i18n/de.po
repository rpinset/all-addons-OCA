#, python-format
msgid ""
"On the payment mode %(name)s, the bank account link is 'Fixed' but the fixed "
"bank journal is not set"
msgstr ""
"Bei der Zahlungsart %(name)s ist die Bankverbindung als „fest“ hinterlegt, "
"das entsprechende Bankjournal ist jedoch nicht eingerichtet"

#. module: account_payment_mode
#. odoo-python
#: code:addons/account_payment_mode/models/account_payment_mode.py:0
#, python-format
msgid ""
"On the payment mode %(paymode)s, the payment method is %(paymethod)s (it is "
"in fact a debit method), but this debit method is not part of the debit "
"methods of the fixed bank journal %(journal)s"
msgstr ""
"Bei der Zahlungsart %(paymode)s ist die Zahlungsmethode %(paymethod)s (es "
"handelt sich dabei um eine Lastschrift), doch diese Lastschrift ist nicht in "
"den Lastschriftmethoden des festen Bankjournals %(journal)s enthalten"

#. module: account_payment_mode
#. odoo-python
#: code:addons/account_payment_mode/models/account_payment_mode.py:0
#, python-format
msgid ""
"On the payment mode %(paymode)s, the payment method is %(paymethod)s, but "
"this payment method is not part of the payment methods of the fixed bank "
"journal %(journal)s"
msgstr ""
"Bei der Zahlungsart %(paymode)s ist die Zahlungsmethode %(paymethod)s, doch "
"diese Zahlungsmethode ist nicht in den Zahlungsmethoden des festgelegten "
"Bankjournals %(journal)s enthalten"

