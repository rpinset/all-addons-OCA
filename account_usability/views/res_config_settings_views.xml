<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="account" position="inside">
                <block name="anglo_saxon_setting_container" title="Anglo-Saxon Accounting">
                    <setting
                        id="anglo_saxon_accounting"
                        help="Record the cost of a good as an expense when this good is
                        invoiced to a final customer (instead of recording the cost as soon
                        as the product is received in stock).">
                        <field name="anglo_saxon_accounting" string="Anglo-Saxon Accounting" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
