<odoo>
    <template id="report_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h3>Certificate</h3>
                        <table class="table table-sm">
                            <tr>
                                <td>Provider</td>
                                <td>AT1 A-Trust</td>
                            </tr>
                            <tr>
                                <td>Type</td>
                                <td>
                                    <span t-field="o.cert_type" />
                                </td>
                            </tr>
                            <tr>
                                <td>Serial</td>
                                <td>
                                    <span t-field="o.serial_hex" />
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
