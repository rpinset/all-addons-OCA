<odoo>
    <record id="asign_cert_view_form" model="ir.ui.view">
        <field name="name">asign.cert.view.form</field>
        <field name="model">asign.cert</field>
        <field name="arch" type="xml">
            <form string="a.sign Certificate">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="cert_name" invisible="1" />
                            <field
                                name="cert"
                                filename="cert_name"
                                required="cert_type == 'online'"
                                readonly="cert_type != 'online'"
                            />
                        </group>
                        <group>
                            <field name="cert_type" />
                            <field
                                name="user"
                                invisible="cert_type != 'online'"
                                required="cert_type == 'online'"
                            />
                            <field
                                name="password"
                                invisible="cert_type != 'online'"
                                required="cert_type == 'online'"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asign_cert_view_tree" model="ir.ui.view">
        <field name="name">asign.cert.view.list</field>
        <field name="model">asign.cert</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_hex" />
                <field name="cert_type" />
            </list>
        </field>
    </record>

    <record id="asign_cert_view_search" model="ir.ui.view">
        <field name="name">asign.cert.view.search</field>
        <field name="model">asign.cert</field>
        <field name="arch" type="xml">
            <search string="Search Certificate">
                <field name="serial_hex" string="Serial Number" />
                <group>
                    <filter
                        name="group_by_cert_type"
                        string="Certificate Type"
                        context="{'group_by': 'cert_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="asign_cert_action" model="ir.actions.act_window">
        <field name="name">a.sign Certificate(s)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">asign.cert</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new a.sign certificate.
            </p>
            <p>Click on Create to add a new certificate.</p>
        </field>
    </record>

    <menuitem
        id="asign_menu_categ"
        name="a.sign RKSV"
        parent="point_of_sale.menu_point_config_product"
        sequence="11"
    />

    <menuitem
        id="asign_menu_act"
        name="a.sign Certificate(s)"
        parent="asign_menu_categ"
        action="asign_cert_action"
        sequence="10"
    />
</odoo>
