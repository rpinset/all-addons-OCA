<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_at_pos_rksv.OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-if="order.asign_state">
                <br />
                <t t-if="order.asign_state == 'u'">
                    <b>The receipt could not be signed and is therefore not valid!</b>
                </t>
                <t t-elif="order.asign_state == 's'">
                    <br />
                    <br />
                    <img
                        id="asign_qrcode"
                        t-att-src="asignQrCode"
                        class="pos-receipt-qrcode"
                    />
                    <div class="pos-receipt-qrcode-text">
                        <t t-esc="order.config.asign_pid" />:
                        <t t-esc="order.asign_serial" />
                    </div>
                    <div
                        t-if="order.asign_type == '0'"
                        class="pos-receipt-qrcode-text"
                    >NULLBELEG</div>
                    <div
                        t-if="order.asign_type == 's'"
                        class="pos-receipt-qrcode-text"
                    >STARTBELEG</div>
                    <div
                        t-if="order.asign_type == 'c'"
                        class="pos-receipt-qrcode-text"
                    >STORNO</div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
