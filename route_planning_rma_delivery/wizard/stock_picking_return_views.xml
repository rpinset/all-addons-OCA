<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_return_picking_form" model="ir.ui.view">
        <field name="model">stock.return.picking</field>
        <field
            name="inherit_id"
            ref="route_planning_rma.view_stock_return_picking_form"
        />
        <field name="arch" type="xml">
            <field name="reception_route_area_id" position="attributes">
                <attribute
                    name="invisible"
                >not create_rma or reception_carrier_delivery_type != 'route_planning'</attribute>
                <attribute
                    name="required"
                >reception_carrier_delivery_type=='route_planning'</attribute>
            </field>
        </field>
    </record>
</odoo>
