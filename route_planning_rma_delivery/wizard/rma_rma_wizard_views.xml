<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rma_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">rma.rma.wizard</field>
        <field name="inherit_id" ref="route_planning_rma.rma_rma_wizard_form_view" />
        <field name="arch" type="xml">
            <field name="reception_route_area_id" position="attributes">
                <attribute name="required">delivery_type=='route_planning'</attribute>
                <attribute
                    name="invisible"
                >delivery_type != 'route_planning'</attribute>
            </field>
        </field>
    </record>
</odoo>
