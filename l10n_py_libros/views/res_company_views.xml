<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_libros" model="ir.ui.view">
        <field name="name">res.company.form.libros</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Libros DNIT">
                    <field name="l10n_py_libro_iva_activo" />
                    <field name="l10n_py_libro_ire_activo" />
                    <field name="l10n_py_libro_irp_rsp_activo" />
                    <field name="l10n_py_libro_nc_nd_direction" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
