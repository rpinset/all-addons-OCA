<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_libros" model="ir.ui.view">
        <field name="name">account.move.form.libros</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="DNIT - Libros"
                    name="l10n_py_libros"
                    invisible="move_type not in ['in_invoice', 'in_refund']"
                >
                    <group>
                        <field name="l10n_py_libro_supplier_timbrado" />
                        <field name="l10n_py_libro_supplier_number" />
                        <field name="l10n_py_libro_electronic" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
