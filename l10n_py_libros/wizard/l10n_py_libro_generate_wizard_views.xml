<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_l10n_py_libro_generate_wizard_form" model="ir.ui.view">
        <field name="name">l10n_py.libro.generate.wizard.form</field>
        <field name="model">l10n_py.libro.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" />
                    <field name="obligacion" />
                    <field name="year" />
                    <field name="month" invisible="obligacion == '956'" />
                </group>
                <group string="Tipos de registro a generar">
                    <field name="incluir_ventas" />
                    <field name="incluir_compras" />
                    <field name="incluir_ingresos" />
                    <field name="incluir_egresos" />
                </group>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_py_libro_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generar Libros DNIT</field>
        <field name="res_model">l10n_py.libro.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
