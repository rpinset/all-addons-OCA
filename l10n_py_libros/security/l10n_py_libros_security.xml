<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_l10n_py_libro_multi_company" model="ir.rule">
        <field name="name">l10n_py.libro multi-company</field>
        <field name="model_id" ref="model_l10n_py_libro" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_l10n_py_libro_line_multi_company" model="ir.rule">
        <field name="name">l10n_py.libro.line multi-company</field>
        <field name="model_id" ref="model_l10n_py_libro_line" />
        <field name="domain_force">
            ['|', ('libro_id.company_id', '=', False), ('libro_id.company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
