<odoo>
    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="name">mrp.production.form (in edi_mrp_oca)</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="before">
                <field name="edi_config" invisible="1" />
                <field name="edi_has_form_config" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    class="oe_stat_button"
                    icon="fa-retweet"
                    name="action_view_edi_records"
                    attrs="{'invisible': [('exchange_record_count', '=', 0)]}"
                >
                    <field
                        string="EDI"
                        name="exchange_record_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="edi" string="EDI">
                    <group name="edi_mrp_group" string="Electronic Data Interchange">
                        <field name="edi_disable_auto" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
