<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_department_form" model="ir.ui.view">
            <field name="name">hr.department.form.l10n_et_hr</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="ethiopic_name" />
                </xpath>
            </field>
        </record>

        <record id="view_department_filter" model="ir.ui.view">
            <field name="name">hr.department.search.l10n_et_hr</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_filter" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="ethiopic_name" string="የሥራ ክፍል" />
                </xpath>
            </field>
        </record>

        <record id="hr_department_view_kanban" model="ir.ui.view">
            <field name="name">hr.department.kanban.l10n_et_hr</field>
            <field name="model">hr.department</field>
            <field name="priority">99</field>
            <field name="inherit_id" ref="hr.hr_department_view_kanban" />
            <field name="arch" type="xml">
                <xpath
                    expr="//div[hasclass('o_kanban_card_header_title')]/div[hasclass('o_primary')]/field[@name='name']"
                    position="replace"
                >
                    <field name="display_name" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
