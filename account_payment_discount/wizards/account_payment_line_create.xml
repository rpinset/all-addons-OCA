<odoo>
    <record id="account_payment_line_create_form" model="ir.ui.view">
        <field name="model">account.payment.line.create</field>
        <field
            name="inherit_id"
            ref="account_payment_batch_oca.account_payment_line_create_form"
        />
        <field name="arch" type="xml">
            <field name="date_type" position="after">
                <field
                    name="cash_discount_date"
                    required="date_type=='discount_due_date'"
                    invisible="date_type!='discount_due_date'"
                />
            </field>
        </field>
    </record>
</odoo>
