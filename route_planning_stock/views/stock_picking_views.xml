<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_route_planning"
                    class="oe_stat_button"
                    icon="fa-arrows-alt"
                    type="object"
                    groups="route_planning.group_route_planning_user"
                    invisible="not has_route_planning"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Route planning</span>
                    </div>
                </button>
            </div>
            <field name="owner_id" position="after">
                <field
                    name="route_area_id"
                    options="{'no_create': True, 'no_open': True}"
                    invisible="not partner_id"
                    readonly="state in ['done', 'cancel']"
                    groups="route_planning.group_route_planning_user"
                />
            </field>
        </field>
    </record>
    <record id="view_picking_list" model="ir.ui.view">
        <field name="name">stock.picking.list.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="route_area_id"
                    optional="hide"
                    groups="route_planning.group_route_planning_user"
                />
            </field>
        </field>
    </record>
</odoo>
