<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="payment_mode_outbound_international_ct1" model="account.payment.mode">
        <field name="name">International Credit Transfer</field>
        <field name="company_id" ref="base.main_company" />
        <field name="bank_account_link">variable</field>
        <field name="payment_method_id" ref="international_credit_transfer" />
        <field name="default_journal_ids" search="[('type', '=', 'purchase')]" />
    </record>

    <!-- Azure Interior -->
    <record id="base.res_partner_12" model="res.partner">
        <field
            name="supplier_payment_mode_id"
            ref="payment_mode_outbound_international_ct1"
        />
    </record>
    <record id="account_payment_mode.res_partner_12_iban" model="res.partner.bank">
        <field name="intermediary_bank_id" ref="account_payment_mode.bank_fortis" />
    </record>

    <!-- Wood Corner -->
    <record id="base.res_partner_1" model="res.partner">
        <field
            name="supplier_payment_mode_id"
            ref="payment_mode_outbound_international_ct1"
        />
    </record>
    <record id="base_iban.bank_iban_asustek" model="res.partner.bank">
        <field name="intermediary_bank_id" ref="base.bank_ing" />
    </record>

</odoo>
