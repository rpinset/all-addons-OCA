#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid ""
"%(name)s is already counted: set its serial number before counting another "
"one."
msgstr ""
"%(name)s è già stato contato: impostare il suo numero di serie prima di "
"contarne un altro."

#. module: barcode_inventory
#. odoo-javascript
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "%(name)s is not a storable product: it has no stock to count."
msgstr "%(name)s non è un prodotto stoccabile: non ha giacenza da contare."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Add Product"
msgstr "Aggiungi prodotto"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Apply Adjustment ("
msgstr "Applica rettifica ("

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Apply anyway"
msgstr "Applica comunque"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Applying..."
msgstr "Applicazione in corso..."

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "Barcode count: %(location)s"
msgstr "Conteggio codice a barre: %(location)s"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "COUNT — SCAN OR TYPE THE COUNTED QTY"
msgstr "CONTEGGIO — SCANSIONA O DIGITA LA Q.TÀ CONTATA"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Count at least one product before applying."
msgstr "Contare almeno un prodotto prima di applicare."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/tiles/inventory_menu_tiles.esm.js:0
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Inventory Adjustment"
msgstr "Rettifica di inventario"

#. module: barcode_inventory
#: model:ir.model,name:barcode_inventory.model_stock_inventory
msgid "Inventory Adjustment Group"
msgstr "Gruppo di rettifica di inventario"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Inventory adjusted: %(n)s product(s)."
msgstr "Inventario rettificato: %(n)s prodotto/i."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Loading locations..."
msgstr "Caricamento ubicazioni..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Loading products..."
msgstr "Caricamento prodotti..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Loading stock..."
msgstr "Caricamento giacenze..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Lot / Serial number"
msgstr "Lotto / Numero di serie"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_location_screen.esm.js:0
msgid "No internal location matches “%(code)s”."
msgstr "Nessuna ubicazione interna corrisponde a “%(code)s”."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "No internal locations found."
msgstr "Nessuna ubicazione interna trovata."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
#: code:addons/barcode_inventory/static/src/js/screens/inventory_product_selector_screen.esm.js:0
msgid "No product matches “%(code)s”."
msgstr "Nessun prodotto corrisponde a “%(code)s”."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "No products found."
msgstr "Nessun prodotto trovato."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "No stock here yet — scan or add a product."
msgstr "Nessuna giacenza qui al momento — scansiona o aggiungi un prodotto."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "On hand:"
msgstr "A disposizione:"

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "One of the scanned products no longer exists."
msgstr "Uno dei prodotti scansionati non esiste più."

#. module: barcode_inventory
#. odoo-javascript
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Only inventory administrators can apply a count."
msgstr "Solo gli amministratori dell'inventario possono applicare un conteggio."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "PRODUCTS"
msgstr "PRODOTTI"

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid ""
"Product %(name)s is tracked: scan or type its lot/serial number before "
"counting it."
msgstr ""
"Il prodotto %(name)s è tracciato: scansionare o digitare il suo numero di "
"lotto/serie prima di contarlo."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "SELECT A LOCATION TO COUNT"
msgstr "SELEZIONA UN'UBICAZIONE DA CONTARE"

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "Scan at least one product to adjust before applying."
msgstr "Scansionare almeno un prodotto da rettificare prima di applicare."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Scan or search a location..."
msgstr "Scansiona o cerca un'ubicazione..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Scan or search a product..."
msgstr "Scansiona o cerca un prodotto..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/xml/inventory_templates.xml:0
msgid "Scan, or add a product..."
msgstr "Scansiona o aggiungi un prodotto..."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Serial number %(lot)s is already counted."
msgstr "Il numero di serie %(lot)s è già stato contato."

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "Serial number %(lot)s of %(name)s can only be counted once."
msgstr ""
"Il numero di serie %(lot)s di %(name)s può essere contato una sola volta."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Set the lot/serial for %(name)s before applying."
msgstr "Impostare il lotto/numero di serie per %(name)s prima di applicare."

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid ""
"Several lots/serial numbers of %(name)s match %(lot)s: type it exactly as it"
" is written."
msgstr ""
"Diversi numeri di lotto/serie di %(name)s corrispondono a %(lot)s: digitarlo "
"esattamente come è scritto."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Stock changed"
msgstr "Giacenza modificata"

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid ""
"The count could not be applied: Odoo asks for a check of the adjustment. "
"Count the location again."
msgstr ""
"Non è stato possibile applicare il conteggio: Odoo richiede una verifica "
"della rettifica. Contare nuovamente l'ubicazione."

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "The counted quantity for %(name)s cannot be negative."
msgstr "La quantità contata per %(name)s non può essere negativa."

#. module: barcode_inventory
#. odoo-javascript
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "The counted quantity for %(name)s is not a number."
msgstr "La quantità contata per %(name)s non è un numero."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "The quantity on the label of %(name)s cannot be read."
msgstr "Impossibile leggere la quantità sull'etichetta di %(name)s."

#. module: barcode_inventory
#. odoo-python
#: code:addons/barcode_inventory/models/stock_inventory.py:0
msgid "The selected location is no longer valid."
msgstr "L'ubicazione selezionata non è più valida."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "The stock changed here while you counted:"
msgstr "La giacenza qui è cambiata durante il conteggio:"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Wait until the count is applied to scan again."
msgstr "Attendere che il conteggio sia applicato prima di scansionare di nuovo."

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "Your counted quantities will be set all the same. Apply the count?"
msgstr ""
"Le quantità contate verranno comunque impostate. Applicare il conteggio?"

#. module: barcode_inventory
#. odoo-javascript
#: code:addons/barcode_inventory/static/src/js/screens/inventory_count_screen.esm.js:0
msgid "• %(what)s: %(shown)s %(uom)s when counting, %(now)s now"
msgstr "• %(what)s: %(shown)s %(uom)s durante il conteggio, %(now)s ora"
