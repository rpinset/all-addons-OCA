<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="edi_conf_notify_on_exchange_error" model="edi.configuration">
        <field name="name">Notify Users On Exchange Error</field>
        <field name="description">
            Schedule activities for configured users/groups on EDI process errors.
        </field>
        <field name="is_global">True</field>
        <field name="trigger_id" ref="edi_core_oca.edi_config_trigger_record_error" />
        <field name="snippet_before_do">
exc_type = record.type_id
result = {
    "todo": exc_type.notify_on_process_error_enabled
}
        </field>
        <field name="snippet_do">
result = env["edi.notification.tool"].on_edi_exchange_error(record)
        </field>
    </record>
</odoo>
