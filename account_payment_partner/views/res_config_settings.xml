<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.account.payment.partner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='pay_invoice_online_setting_container']"
                position="inside"
            >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="keep_partner_bank_without_payment_mode" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="keep_partner_bank_without_payment_mode" />
                        <div class="text-muted">
                            Keep the bank account auto-selected by Odoo
                            on invoices without a payment mode. Disable
                            to clear the bank account when no payment
                            mode is set.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
