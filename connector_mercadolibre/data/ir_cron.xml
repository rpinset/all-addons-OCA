<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_tokens" model="ir.cron">
        <field name="name">Mercado Libre: refresh access tokens</field>
        <field name="model_id" ref="model_mercadolibre_backend" />
        <field name="state">code</field>
        <field name="code">model.cron_refresh_tokens()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
