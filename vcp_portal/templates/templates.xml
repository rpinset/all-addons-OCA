<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="vcp_platform_template" name="View contributors">
        <t t-call="portal.portal_layout">
            <owl-component
                name="vcp_portal.VcpRender"
                t-att-props="json.dumps({'vcp': vcp})"
            />
        </t>
    </template>
    <template id="vcp_platforms_template" name="View contributors">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="False" />
            <div class="o_portal_my_home">
                <div class="oe_structure" id="oe_structure_portal_my_home_1" />
                <div class="o_portal_docs row g-2">
                    <div class="o_portal_category row g-2 mt-3" id="portal_vcps">
                        <t t-foreach="vcps" t-as="vcp">
                            <t t-call="portal.portal_docs_entry" t-if="False" />
                            <t t-call="portal.portal_docs_entry">
                                <t
                                    t-set="icon"
                                    t-value="'/web/image/vcp.platform/' + str(vcp.id) + '/image_64'"
                                />
                                <t
                                    t-set="title"
                                    t-value="vcp.short_description or vcp.name"
                                />
                                <t
                                    t-set="text"
                                    t-value="vcp.description or 'No description available.'"
                                />
                                <t t-set="url" t-value="'/vcp/%s' % vcp.name" />
                                <t t-set="config_card" t-value="True" />
                            </t>
                        </t>
                    </div>
                    <div
                        class="o_portal_doc_spinner spinner-border text-o-color-2 align-self-center mt-5"
                    />
                </div>
            </div>
        </t>
    </template>

    <template
        id="portal_my_home_contributors"
        name="Contributors"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="40"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True" />
            <t t-set="portal_vendor_category_enable" t-value="True" />
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/vcp/static/description/icon.svg'" />
                <t t-set="title">Version Control Platforms</t>
                <t t-set="url" t-value="'/vcp'" />
                <t t-set="text">Show Version Control Platform information</t>
                <t t-set="config_card" t-value="True" />
            </t>
        </div>
    </template>
    <!-- We add this view to avoid glue modules -->
    <template id="vcp_partner_detail">
        <div class="row mt-4 o_contributors_data">
            <div class="col-6 col-md-2 mb-3 o_contributors_merged_requests">
                <h5>Merged Requests</h5>
                <span class="h3" t-esc="partner.vcp_merged_requests" />
            </div>
            <div class="col-6 col-md-2 mb-3 o_contributors_created_requests">
                <h5>Created Requests</h5>
                <span class="h3" t-esc="partner.vcp_created_requests" />
            </div>
            <div class="col-6 col-md-2 mb-3 o_contributors_comments">
                <h5>Comments</h5>
                <span class="h3" t-esc="partner.vcp_comments" />
            </div>
            <div class="col-6 col-md-2 mb-3 o_contributors_reviews">
                <h5>Reviews</h5>
                <span class="h3" t-esc="partner.vcp_reviews" />
            </div>
        </div>
    </template>
</odoo>
