<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Tipos de identificación para Paraguay -->

    <record id="it_ruc" model="l10n_latam.identification.type">
        <field name="name">RUC</field>
        <field name="description">Registro Único del Contribuyente</field>
        <field name="country_id" ref="base.py" />
        <field name="is_vat" eval="True" />
        <field name="sequence">10</field>
    </record>

    <record id="it_ci" model="l10n_latam.identification.type">
        <field name="name">CI</field>
        <field name="description">Cédula de Identidad</field>
        <field name="country_id" ref="base.py" />
        <field name="sequence">20</field>
    </record>

    <record id="it_pasaporte" model="l10n_latam.identification.type">
        <field name="name">Pasaporte</field>
        <field name="description">Pasaporte</field>
        <field name="country_id" ref="base.py" />
        <field name="sequence">30</field>
    </record>

    <record id="it_carnet_residencia" model="l10n_latam.identification.type">
        <field name="name">Carnet de Residencia</field>
        <field name="description">Carnet de Residencia</field>
        <field name="country_id" ref="base.py" />
        <field name="sequence">40</field>
    </record>

</odoo>
