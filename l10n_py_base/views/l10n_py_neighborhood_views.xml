<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_l10n_py_neighborhood_list" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.list</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="zipcode" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l10n_py_neighborhood_form" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.form</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <form string="Barrio">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="zipcode" />
                        </group>
                        <group>
                            <field name="country_id" />
                            <field name="state_id" />
                            <field name="city_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l10n_py_neighborhood_search" model="ir.ui.view">
        <field name="name">l10n_py.neighborhood.search</field>
        <field name="model">l10n_py.neighborhood</field>
        <field name="arch" type="xml">
            <search string="Barrios">
                <field name="name" />
                <field name="code" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="zipcode" />
                <filter
                    string="Por Ciudad"
                    name="group_by_city"
                    context="{'group_by': 'city_id'}"
                />
                <filter
                    string="Por Departamento"
                    name="group_by_state"
                    context="{'group_by': 'state_id'}"
                />
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_l10n_py_neighborhood" model="ir.actions.act_window">
        <field name="name">Barrios</field>
        <field name="res_model">l10n_py.neighborhood</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo barrio
            </p>
            <p>
                Los barrios son subdivisiones de las ciudades en Paraguay.
                Puede crear barrios para organizar mejor las direcciones.
            </p>
        </field>
    </record>

    <!-- Menu Item: Contactos > Configuración > Localización > Barrios -->
    <menuitem
        id="menu_l10n_py_neighborhood"
        name="Barrios"
        parent="contacts.menu_localisation"
        action="action_l10n_py_neighborhood"
        sequence="4"
    />
</odoo>
