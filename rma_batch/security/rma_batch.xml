<odoo>
    <record model="ir.model.access" id="rma_batch_access">
        <field name="name">rma.batch access</field>
        <field name="model_id" ref="model_rma_batch" />
        <field name="group_id" ref="rma.rma_group_user_own" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="rma_batch_rule_user_own" model="ir.rule">
        <field name="name">Personal RMA Batches</field>
        <field name="model_id" ref="model_rma_batch" />
        <field
            name="domain_force"
        >['|',('user_id','=',user.id),('user_id','=',False)]</field>
        <field name="groups" eval="[(4, ref('rma.rma_group_user_own'))]" />
    </record>
    <record id="rma_batch_rule_user_all" model="ir.rule">
        <field name="name">All RMA Batches</field>
        <field name="model_id" ref="model_rma_batch" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('rma.rma_group_user_all'))]" />
    </record>
    <record id="rma_batch_rule_multi_company" model="ir.rule">
        <field name="name">RMA Batches multi-company</field>
        <field name="model_id" ref="model_rma" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
