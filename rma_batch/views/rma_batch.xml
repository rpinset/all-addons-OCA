<odoo>
    <record id="rma_batch_form_view" model="ir.ui.view">
        <field name="model">rma.batch</field>
        <field name="arch" type="xml">
            <form string="RMA Batch">
                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        invisible="state != 'ready'"
                        class="btn-primary"
                    />
                    <button
                        name="action_ready"
                        string="Mark as Ready"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'cancelled'"
                    />
                    <button
                        name="action_draft"
                        string="Set to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'cancelled'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,ready,confirmed"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_open_rma"
                            class="oe_stat_button"
                            icon="fa-reply"
                            invisible="count_rma == 0"
                        >
                            <field name="count_rma" widget="statinfo" string="RMA(s)" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'" />
                        </h1>
                    </div>
                    <group>
                        <group name="main_group_left">
                            <field
                                name="partner_id"
                                widget="res_partner_many2one"
                                context="{'search_default_customer':1, 'show_address': 1, 'show_vat': True}"
                                readonly="state != 'draft'"
                                options="{'always_reload': True}"
                            />
                            <field
                                name="partner_shipping_id"
                                readonly="state != 'draft'"
                                force_save="1"
                            />
                            <field
                                name="partner_invoice_id"
                                readonly="state != 'draft'"
                                force_save="1"
                            />
                            <field
                                name="operation_id"
                                required="True"
                                readonly="state != 'draft'"
                            />
                            <field name="location_id" readonly="state != 'draft'" />
                        </group>
                        <group name="main_group_right">
                            <field name="date" readonly="state != 'draft'" />
                            <field name="user_id" readonly="state != 'draft'" />
                            <field name="team_id" readonly="state != 'draft'" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                                placeholder="Tags..."
                            />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="RMA">
                            <field name="rma_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <button
                                        name="action_show_rma"
                                        type="object"
                                        class="fa fa-folder-open text-primary"
                                        title="Show RMA"
                                    />
                                    <field name="product_id" />
                                    <field name="product_uom_qty" />
                                    <field
                                        name="product_uom"
                                        groups="uom.group_uom"
                                        domain="[('category_id', '=', uom_category_id)]"
                                    />
                                    <field name="operation_id" />
                                    <field
                                        name="state"
                                        readonly="True"
                                        force_save="True"
                                    />
                                    <field name="partner_id" optional="hide" />
                                    <field name="user_id" optional="hide" />
                                    <field name="team_id" optional="hide" />
                                    <field
                                        name="tag_ids"
                                        optional="hide"
                                        widget="many2many_tags"
                                    />
                                    <field name="date" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="rma_batch_list_view" model="ir.ui.view">
        <field name="model">rma.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="state" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="rma_batch_act_window" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">rma.batch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="rma_batch_menu" model="ir.ui.menu">
        <field name="name">Batches</field>
        <field name="parent_id" ref="rma.rma_menu" />
        <field name="action" ref="rma_batch_act_window" />
        <field name="sequence" eval="5" />
    </record>
</odoo>
